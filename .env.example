# Studio Layl — Supabase production environment
# Project: layal-studio
# Project ref: fjwhkxxvpqyospfjehik

# Server-side Supabase URL
SUPABASE_URL=https://fjwhkxxvpqyospfjehik.supabase.co

# Supabase publishable key. Obtain it from Supabase after restoring the project.
# This key is safe for browser use when RLS policies are correctly configured.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_u3aExJEOJYQxhpEDLaozKQ_fhBiBFe2

# Supabase service-role/secret key. Server-only; never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Browser build variables. Use the same URL and publishable key above.
VITE_SUPABASE_URL=https://fjwhkxxvpqyospfjehik.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_u3aExJEOJYQxhpEDLaozKQ_fhBiBFe2

# Optional local development database URL for Drizzle CLI migrations.
# DATABASE_URL=REPLACE_WITH_POSTGRES_CONNECTION_STRING

# Nitro deployment target for Vercel.
NITRO_PRESET=vercel

# Custom admin credentials are stored as a scrypt hash in public.admin_users.
# Do not add an admin password to Vercel Environment Variables.
